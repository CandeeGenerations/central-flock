#!/usr/bin/env bash
# Auto-deploy when a commit lands on main. Feature branch commits are skipped.
# Bypass with: SKIP_DEPLOY=1 git commit ...

if [[ -n "${SKIP_DEPLOY:-}" ]]; then
  echo "post-commit: SKIP_DEPLOY set, skipping deploy"
  exit 0
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [[ "$BRANCH" != "main" ]]; then
  exit 0
fi

# Source .env.deploy if present — needed when invoked from GUI git clients
# (GitHub Desktop, Tower, etc.) that don't inherit the user's shell env.
REPO_ROOT="$(git rev-parse --show-toplevel)"
if [[ -f "$REPO_ROOT/.env.deploy" ]]; then
  # shellcheck disable=SC1091
  source "$REPO_ROOT/.env.deploy"
fi

# The full deploy is a few hundred lines of build output. Keep all of it in a
# log file and echo only the step markers, so a commit doesn't bury the terminal
# (or an agent's context) in font asset tables. On failure, dump the tail —
# that's where the error is, since the script exits at the first one.
# DEPLOY_VERBOSE=1 streams everything to the terminal instead.
LOG="$REPO_ROOT/.deploy.log"

echo "post-commit: on main → running deploy (full log: .deploy.log)"

if [[ -n "${DEPLOY_VERBOSE:-}" ]]; then
  "$REPO_ROOT/scripts/deploy.sh"
  exit $?
fi

if "$REPO_ROOT/scripts/deploy.sh" >"$LOG" 2>&1; then
  grep -E '^(==>|    (WARN|ERROR|Verified|Sentry))' "$LOG" || true
  exit 0
fi

STATUS=$?
echo "post-commit: DEPLOY FAILED (exit $STATUS) — last 40 lines:"
echo "─────────────────────────────────────────────"
tail -40 "$LOG"
echo "─────────────────────────────────────────────"
echo "post-commit: full log at .deploy.log"
exit $STATUS
